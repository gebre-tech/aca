---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  id?: string;
}

const { eyebrow, title, intro, id } = Astro.props;
---

<header class="section-heading">
  <p class="section-heading__eyebrow">{eyebrow}</p>
  <h2 id={id} class="section-heading__title">{title}</h2>
  {intro && <p class="section-heading__intro">{intro}</p>}
</header>
