---
type IconName = 'arrow' | 'check' | 'chevron' | 'climate' | 'data' | 'energy' | 'finance' | 'leaf' | 'menu' | 'close';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<span class:list={['icon', className]} aria-hidden="true">
  {name === 'arrow' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M4.75 12h14.5m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
  {name === 'check' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="m5 12.5 4.3 4.3L19.5 6.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
  {name === 'chevron' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="m6.5 9 5.5 5.5L17.5 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
  {name === 'climate' && (
    <svg viewBox="0 0 32 32" fill="none">
      <path d="M16 28V14m0 7c-5.5 0-9-3.1-9-8 5.3 0 8.3 2.4 9 8Zm0-5c0-5.4 3.4-9 9-9 0 5.6-3.3 9-9 9Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M5 28h22" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
    </svg>
  )}
  {name === 'data' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M4 19V5m0 14h16M8 15l3-4 3 2 5-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="8" cy="15" r="1" fill="currentColor" />
      <circle cx="11" cy="11" r="1" fill="currentColor" />
      <circle cx="14" cy="13" r="1" fill="currentColor" />
      <circle cx="19" cy="6" r="1" fill="currentColor" />
    </svg>
  )}
  {name === 'energy' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="m13.2 2.8-8 10.1h6l-.4 8.3 8-10.1h-6l.4-8.3Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
  {name === 'finance' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M3.5 9h17M5 9v9m4-9v9m6-9v9m4-9v9M3.5 21h17M2.5 9l9.5-6 9.5 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
  {name === 'leaf' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M19.8 4.2C10.3 3.7 5 7.5 5 13a6 6 0 0 0 6 6c5.5 0 9.3-5.3 8.8-14.8Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M4 21c2.5-5.2 6.1-8.8 11-11" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
    </svg>
  )}
  {name === 'menu' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  )}
  {name === 'close' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  )}
</span>
