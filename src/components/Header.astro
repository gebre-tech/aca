---
import Button from './Button.astro';
import Icon from './Icon.astro';

const primaryLinks = [
  { label: 'Home', href: '/#home' },
  { label: 'About Us', href: '/#about' },
  { label: 'Services', href: '/#services' },
  { label: 'Projects', href: '/#projects' },
];

const exploreLinks = [
  { label: 'Featured Project', href: '/projects/biogas-forage-dairy/' },
  { label: 'Digital MRV', href: '/#digital-mrv' },
  { label: 'Carbon Markets and Climate Finance', href: '/#carbon-finance' },
  { label: 'Climate Business Models', href: '/#business-models' },
  { label: 'Partners', href: '/#partners' },
  { label: 'Impact', href: '/#impact' },
  { label: 'Why Africa Climate Actions', href: '/#why-us' },
];
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/#home" aria-label="Africa Climate Actions PLC home">
      <span class="brand__mark"><Icon name="climate" /></span>
      <span class="brand__text">Africa Climate Actions PLC</span>
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="primary-navigation"
      data-menu-toggle
    >
      <Icon name="menu" class="menu-toggle__open-icon" />
      <Icon name="close" class="menu-toggle__close-icon" />
    </button>
    <nav id="primary-navigation" class="site-nav" aria-label="Main navigation" data-site-nav>
      {primaryLinks.map((link) => <a class="site-nav__link" href={link.href}>{link.label}</a>)}
      <details class="site-nav__group">
        <summary class="site-nav__summary">
          Explore <Icon name="chevron" class="site-nav__chevron" />
        </summary>
        <div class="site-nav__dropdown">
          {exploreLinks.map((link) => <a class="site-nav__link" href={link.href}>{link.label}</a>)}
        </div>
      </details>
      <Button href="/#contact" class="site-nav__contact" icon="arrow">Contact</Button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const navigation = document.querySelector<HTMLElement>('[data-site-nav]');
  const exploreGroup = document.querySelector<HTMLDetailsElement>('.site-nav__group');

  const updateActiveNavigation = (activeHref?: string) => {
    const links = document.querySelectorAll<HTMLAnchorElement>(
      '.site-nav a[href], .site-footer__nav a[href]',
    );
    const isFeaturedProjectPage = window.location.pathname === '/projects/biogas-forage-dairy/';

    for (const link of links) {
      const target = new URL(link.href);
      const isActive = activeHref
        ? (target.pathname === window.location.pathname && target.hash === `#${activeHref}`) ||
          (isFeaturedProjectPage && target.pathname === window.location.pathname)
        : target.pathname === window.location.pathname &&
          target.pathname !== '/' &&
          isFeaturedProjectPage;

      if (isActive) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    }

    const activeNavigationLink = document.querySelector<HTMLAnchorElement>(
      '.site-nav a[aria-current="location"]',
    );
    if (activeNavigationLink?.closest('.site-nav__group')) {
      exploreGroup?.setAttribute('open', '');
    } else {
      exploreGroup?.removeAttribute('open');
    }
  };

  const hashSection = window.location.hash.slice(1);
  if (hashSection) updateActiveNavigation(hashSection);
  else if (window.location.pathname === '/projects/biogas-forage-dairy/') updateActiveNavigation();

  const observedSections = document.querySelectorAll<HTMLElement>('main section[id]');
  if (observedSections.length > 0 && 'IntersectionObserver' in window) {
    const activeObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((first, second) => second.intersectionRatio - first.intersectionRatio)[0];

        if (visible) updateActiveNavigation((visible.target as HTMLElement).id);
      },
      { rootMargin: '-18% 0px -65% 0px', threshold: [0, 0.2, 0.5, 0.8] },
    );

    observedSections.forEach((section) => activeObserver.observe(section));
  }

  if (
    document.querySelector('[data-reveal]') &&
    'IntersectionObserver' in window &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );

    document.documentElement.classList.add('has-scroll-reveal');
    document.querySelectorAll('[data-reveal]').forEach((element) => revealObserver.observe(element));
  }

  if (toggle && navigation) {
    const closeMenu = () => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation menu');
      navigation.dataset.open = 'false';
      exploreGroup?.removeAttribute('open');
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
      navigation.dataset.open = String(!isOpen);
      if (isOpen) exploreGroup?.removeAttribute('open');
    });

    navigation.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) closeMenu();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && navigation.dataset.open === 'true') {
        closeMenu();
        toggle.focus();
      }
    });

    window.addEventListener('resize', () => {
      if (window.matchMedia('(min-width: 901px)').matches) {
        closeMenu();
        const activeNavigationLink = document.querySelector<HTMLAnchorElement>(
          '.site-nav a[aria-current="location"]',
        );
        if (activeNavigationLink?.closest('.site-nav__group')) {
          exploreGroup?.setAttribute('open', '');
        }
      }
    });
  }
</script>
