---
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'accent' | 'outline' | 'light';
  icon?: 'arrow';
  class?: string;
  id?: string;
}

const { href, variant = 'primary', icon, class: className, id } = Astro.props;
---

<a id={id} class:list={['button', `button--${variant}`, className]} href={href}>
  <slot />
  {icon && <Icon name={icon} class="button__icon" />}
</a>
