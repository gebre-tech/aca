---
import Card from './Card.astro';

interface Props {
  name: string;
  focus: string;
  monogram: string;
  id: string;
}

const { name, focus, monogram, id } = Astro.props;
---

<Card class="partner-card" labelledBy={id}>
  <span class="partner-card__monogram" aria-hidden="true">{monogram}</span>
  <h3 id={id} class="partner-card__name">{name}</h3>
  <p class="partner-card__focus">{focus}</p>
</Card>

<style>
  .partner-card {
    position: relative;
    padding-top: 1.5rem;
  }

  .partner-card__monogram {
    display: grid;
    width: 2.8rem;
    height: 2.8rem;
    place-items: center;
    margin-bottom: 1rem;
    border: 1px solid #bdcec1;
    border-radius: 0.5rem;
    background: #eaf1ec;
    color: var(--color-forest-950);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .partner-card__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  .partner-card__focus {
    margin: 0.65rem 0 0;
    color: var(--color-slate);
    line-height: 1.65;
  }
</style>
